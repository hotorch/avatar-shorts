{
  "$doc": "정책 = 어기면 결과물이 '틀린' 것. 사람마다 다르지 않다. render --check 가 ❌ 로 막는다. 팀/채널 단위로 바꾸고 git 에 올린다. 설명은 style/README.md",
  "version": 1,

  "content": {
    "noFabrication": true,
    "captionsVerbatim": true,
    "hookFaceSeconds": 1.0
  },

  "captions": {
    "$doc": "자막을 어떻게 보여 줄 수 있는지의 승인 목록. 어느 것을 쓸지는 취향(captions.set · font · shape · motion). 세트 = 폰트·모양·움직임을 묶은 것, 세 칸은 따로 덮어쓸 수 있다. 움직임은 motionMaxSec 안에 끝나야 한다 (말이 먼저 나가면 자막이 뒤처져 보인다). 흔들기·반짝이는 금지(motion.banned). 글자는 어떤 세트든 말한 그대로.",
    "maxChars": 18,
    "maxEmphPerCue": 2,
    "bigMaxRatio": 0.3,
    "motionMaxSec": 0.5,
    "sets": {
      "basic":    {"label": "기본",   "font": "suit",       "shape": "strip",   "motion": "none",  "scale": 1,    "fit": "무엇이든. 고민되면 이것"},
      "variety":  {"label": "예능",   "font": "pretendard", "shape": "pop",     "motion": "slam",  "scale": 1.12, "fit": "리액션·반전·밈"},
      "news":     {"label": "뉴스",   "font": "pretendard", "shape": "band",    "motion": "rise",  "scale": 1,    "fit": "정보·이슈 정리"},
      "docu":     {"label": "다큐",   "font": "myeongjo",   "shape": "outline", "motion": "focus", "scale": 1,    "fit": "브랜드 필름·인터뷰"},
      "terminal": {"label": "터미널", "font": "mono",       "shape": "console", "motion": "type",  "scale": 0.95, "fit": "개발·AI·코딩"},
      "tech":     {"label": "테크",   "font": "suit",       "shape": "glass",   "motion": "rise",  "scale": 1,    "fit": "AI 도구·앱 리뷰"},
      "essay":    {"label": "에세이", "font": "allimjang",  "shape": "outline", "motion": "word",  "scale": 1.05, "fit": "일상·감성·공부"}
    },
    "fonts": {
      "suit":       {"label": "SUIT",            "family": "SUIT",                  "weight": 700},
      "pretendard": {"label": "Pretendard 굵게", "family": "Pretendard",            "weight": 800},
      "myeongjo":   {"label": "나눔명조",        "family": "Nanum Myeongjo",        "weight": 800},
      "allimjang":  {"label": "학교안심 알림장", "family": "Hakgyoansim Allimjang", "weight": 400},
      "mono":       {"label": "IBM Plex Mono",   "family": "IBM Plex Mono",         "weight": 500}
    },
    "shapes": {
      "strip":   {"label": "흰 띠"},
      "band":    {"label": "검은 띠"},
      "glass":   {"label": "유리 상자"},
      "outline": {"label": "글자만 (테두리)"},
      "pop":     {"label": "노란 굵은 글자"},
      "console": {"label": "터미널 상자"}
    },
    "motions": {
      "none":  {"label": "없음",        "sec": 0.07},
      "slam":  {"label": "쾅",          "sec": 0.3},
      "rise":  {"label": "쑥 올라오기", "sec": 0.2},
      "focus": {"label": "초점 맞추기", "sec": 0.27},
      "type":  {"label": "타자 치기",   "sec": 0.5},
      "word":  {"label": "단어씩 켜기", "sec": 0.5}
    }
  },

  "face": {
    "$doc": "B-roll 판·카드와 자막은 얼굴(정수리~턱)을 가리지 않는다. 머리 위치는 scripts/face.py 가 영상을 따라가며 잰 값(video.json track). 배치는 src/layouts/framing.js 가 장면마다 계산하고(정수리를 판 아래로, 머리가 크면 판을 줄이거나 아바타를 줄임), render --check 가 순간마다 확인해 막는다. 컷어웨이(화면 전체 교체)는 가리는 게 아니라 바꾸는 것이라 예외. 계기: 분할 화면에서 얼굴 중심만 맞추다 정수리가 190px 가려짐 (avatar-v01).",
    "neverCovered": true,
    "gapPx": 36
  },

  "scenes": {
    "minSec": 1.2,
    "maxSec": 10,
    "maxSameTemplateRun": 2
  },

  "variety": {
    "$doc": "연속으로 비슷한 장면은 지루하다. 장면마다 지문 4축(배치 mode · 등장 모션 · 주인공 에셋 · 첫 효과음)을 뽑아, 바로 앞 장면(사이 얼굴 구간이 windowSec 이하)과 maxSharedAxes 개보다 많이 같으면 막는다. 주인공 에셋(첫 object·center·media src)이 같으면 그것만으로 막는다. morph 안에서 같은 모양(kind)이 연이어 나오면 변화가 안 보여 막는다. 계기: avatar-v01 장면 07~09 가 템플릿 검사는 통과했지만 머리 위 morph 알약이 세 번 연속. 취향 broll.variety 가 strict 면 0개(전부 달라야). 모션은 템플릿이 정한다(motion 표). list·steps 는 둘 다 항목이 차례로 쌓여 같은 모션.",
    "windowSec": 5,
    "maxSharedAxes": 1,
    "sameHeroAdjacent": false,
    "morphSameKindRun": false,
    "motion": {
      "hero": "object-pop",
      "keyword": "type-reveal",
      "stat": "count-up",
      "compare": "split",
      "steps": "stack-build",
      "list": "stack-build",
      "chart": "grow",
      "quote": "paper-drop",
      "chapter": "wipe",
      "morph": "morph",
      "media": "ken-burns",
      "palette": "card-stack",
      "freeze": "freeze-sticker",
      "text-behind": "type-behind-head",
      "shoulder": "cards-behind-shoulders",
      "grade-wipe": "line-wipe",
      "tier": "tiles-fly-in",
      "glass-chart": "count-up"
    }
  },

  "presenterFx": {
    "$doc": "발표자 위 효과 6종(mode fx, src/fx). 사람을 오려내(scripts/fx_matte.py, rembg u2net) 그래픽을 발표자 뒤·앞에 놓는다. 랜덤 배치 없음: 그 장면의 말이 효과의 말과 맞을 때만 — 효과가 쓰는 단어(이름표·글자·atWord)가 그 장면에서 실제로 나와야 하고, 발표자 얼굴이 화면에 있고(faceMissMax), 길이(minSec)·실물 개수(minItems)가 하한을 채울 때만. 같은 효과는 영상당 한 번(oncePerVideo). 그래프 숫자는 출처(source)가 적힌 데이터 파일에서만(손으로 친 숫자 금지). 어깨 효과는 카드 내용(머리 위)이 위 UI 아래에 들어갈 만큼만 발표자를 줄인다 — 원본의 고정 0.74배가 아니라 장면마다 잰 값(src/layouts/framing.js shoulderScaleFor), 하한은 이전부터 있던 아바타 하한 S_MIN 0.8 (그보다 줄여야 하면 ❌, 다른 효과로). 판정 근거: style/README '이전 것과 새로 들인 것이 부딪힐 때'. 출처: reels-factory presenter-fx (2026-10-29, 프롬프트 팩 6효과를 우리 아바타에 다시 지은 것). 고르는 법: .claude/skills/broll-plan/references/presenter-fx.md.",
    "oncePerVideo": true,
    "faceMissMax": 0.3,
    "textBehindMinVisible": 0.7,
    "effects": {
      "freeze": {"minSec": 2.0, "minItems": 0, "says": "사람 이름·소개 (이름표 = 그 장면에서 말한 이름)"},
      "text-behind": {"minSec": 1.5, "minItems": 0, "says": "도구·제품 이름을 처음 부를 때, 한 단어"},
      "shoulder": {"minSec": 2.5, "minItems": 2, "says": "둘을 맞대기, 하나가 다른 하나로 넘기기"},
      "grade-wipe": {"minSec": 1.5, "minItems": 0, "says": "화면·색·화질 자체가 좋아질 때만"},
      "tier": {"minSec": 3.0, "minItems": 3, "says": "순위 매기기·고르기"},
      "glass-chart": {"minSec": 2.0, "minItems": 1, "says": "실제로 잰 숫자가 오르내릴 때 (데이터 파일)"}
    }
  },

  "sceneColors": {
    "$doc": "장면이 바탕·면·타일을 칠할 땐 팔레트·트라이어드 색과 그 색에 검정을 섞은 명암만 쓴다. 레퍼런스 사진의 색·장면마다 다른 브랜드 색을 그대로 칠하지 않는다. 내가 고른 브랜드 색은 npm run brand 를 거쳐 트라이어드(look.triad)·바탕(look.background)으로만 들어온다 — 색 값만, 대비 검사를 통과해야 하고, 이름·로고·서체는 가져오지 않는다. 출처: savee-tile-vertical.mp4(넘길 때마다 바탕색이 사진 색을 따라감) → 우리는 트라이어드를 따라감 (StackCarousel). 커스텀 장면은 검사기가 속을 못 보므로 motion-kit 규칙으로 지킨다. 계기: avatar-v03.",
    "fillsFromThemeOnly": true
  },

  "avatarGrow": {
    "$doc": "컷어웨이 → 얼굴 복귀 전환 '아바타 확대'를 만드는 법 (쓸지 말지는 취향 broll.exit). 출처: 레퍼런스 Scene.mp4(잡지 표지 — 가운데 작은 사진 틀이 계단식으로 커져 화면을 채움). 영상에 맞게: 사진 대신 실제 말하는 아바타 영상(소리 없음), 틀 비율 = 화면 비율이라 마지막 계단이 그대로 얼굴 화면이 된다(이음매 없음). 계단마다 pop 스프링, 마지막 계단의 넘침이 가라앉을 때까지 settleSec 더 그린다. 레퍼런스의 굵은 표지 타이포·라벨은 가져오지 않는다. 바로 뒤가 다른 장면이면(faceAfterSec 미만) 판·카드 배치와 겹쳐 튀므로 wipe. 계기: avatar-v03.",
    "durationSec": 0.8,
    "steps": [
      {"before": 1.0, "scale": 0.2},
      {"before": 0.62, "scale": 0.46},
      {"before": 0.3, "scale": 1}
    ],
    "settleSec": 0.7,
    "faceAfterSec": 1.0,
    "minBrollSec": 0.8
  },

  "edit": {
    "$doc": "무음·군더더기 제거와 재배치의 한계. 취향(silence)이 이보다 느슨할 수는 있어도 이 선을 넘지 못한다.",
    "maxSilenceKept": 0.45,
    "minPad": 0.04,
    "fadeMs": 8,
    "fillers": ["음", "어", "음…", "어…", "음..", "어..", "으음", "그니까"]
  },

  "gradient": {
    "$doc": "그라디언트 면은 트라이어드 3색만으로, 4레이어 레시피로 만든다. 출처: 팔레트 카드 가이드 Part 2. 레퍼런스 이미지 6장과 같은 3색으로 렌더해 비교 — 패널 48곳 평균 ΔE 1.5~3.0 (눈으로 거의 구분 안 됨).",
    "recipe": "triad-4layer",
    "colorsFromTriadOnly": true,
    "interpolation": "srgb",
    "animateInside": false,
    "glow": false,
    "textOnGradient": "white-on-dark-zone-only"
  },

  "triad": {
    "$doc": "트라이어드 = 진한색·포인트색·밝은색 3색 한 벌. 레퍼런스 6장(color.bears 'Steal these gradients')을 직접 보고 규칙을 '밝기'가 아니라 '글자 대비'로 정함: 진한색이 꼭 검정은 아니고(0038BD, 576238), 포인트색이 밝은색보다 밝을 수도 있다(DCFC73 > E1D2F3). 탭2 글자(포인트색 위 밝은색)는 흐린 게 원래 디자인이라 검사하지 않는다.",
    "contrast": {
      "whiteOnDark": 4.5,
      "accentOnDark": 3.0,
      "darkOnLight": 4.5
    },
    "approved": {
      "void-citrine":   {"c": ["#0C0C0C", "#DCFC73", "#E1D2F3"], "n": ["Void", "Citrine", "Lilac Mist"], "src": "ref"},
      "oxblood-guava":  {"c": ["#4C1413", "#EA6B7E", "#FFDBED"], "n": ["Oxblood", "Guava", "Blossom"], "src": "ref"},
      "cobalt-amber":   {"c": ["#0038BD", "#EF8E01", "#EEEEEE"], "n": ["Cobalt", "Amber", "Paper"], "src": "ref"},
      "arctic-haze":    {"c": ["#0F464B", "#F4EC9B", "#C9E0DA"], "n": ["Deep Arctic", "Sun Haze", "Glacier"], "src": "ref"},
      "chestnut-sky":   {"c": ["#432F2E", "#C3DAE8", "#FEEFB6"], "n": ["Chestnut", "Pale Sky", "Nectar"], "src": "ref"},
      "moss-harvest":   {"c": ["#576238", "#FFD95E", "#F0EADC"], "n": ["Moss", "Harvest", "Linen"], "src": "ref"},
      "kelp":           {"c": ["#1B3A34", "#E9F07A", "#CFE8E4"], "n": ["Kelp Shadow", "Citron Glow", "Pale Lagoon"], "src": "guide"},
      "plum":           {"c": ["#2A1633", "#FF8A3D", "#FFE3CF"], "n": ["Ink Plum", "Tangerine Pop", "Peach Cloud"], "src": "guide"},
      "cobalt":         {"c": ["#102A8C", "#8FD3FF", "#EEF3F8"], "n": ["Cobalt Night", "Sky Sherbet", "Frost Paper"], "src": "guide"},
      "espresso":       {"c": ["#3B2A20", "#F5B642", "#F4ECDD"], "n": ["Espresso Bark", "Honey Amber", "Oat Milk"], "src": "guide"},
      "carbon":         {"c": ["#141A12", "#B6F24E", "#E6DBF5"], "n": ["Carbon Moss", "Acid Fern", "Lilac Dust"], "src": "guide"},
      "garnet":         {"c": ["#5A0F24", "#F07A9A", "#FFE1EA"], "n": ["Garnet Deep", "Rose Quartz", "Cotton Blush"], "src": "guide"},
      "teal-night":     {"c": ["#0B2B2F", "#12B5A6", "#DDF3EF"], "n": ["Deep Lagoon", "Signal Teal", "Mint Paper"], "src": "kit"},
      "violet-ink":     {"c": ["#1E1446", "#8A6CF0", "#ECE6FF"], "n": ["Violet Ink", "Iris", "Lilac Paper"], "src": "kit"},
      "terracotta":     {"c": ["#3B2A20", "#E07A4F", "#F4ECDD"], "n": ["Espresso Bark", "Terracotta", "Oat Milk"], "src": "kit"}
    },
    "paletteDefault": {"darktech": "teal-night", "editorial": "violet-ink", "academic": "terracotta"},
    "auto": {
      "$doc": "look.triad 가 auto 면 영상 배경색(video.json tones)과 포인트색 색상이 가까운 승인 트라이어드를 고른다. 배경 채도가 낮으면(chroma < minChroma) 팔레트 기본.",
      "minChroma": 0.06,
      "hueWindow": 45,
      "darkWeight": 0.35
    }
  },

  "motion": {
    "banned": ["particles", "rainbow-gradient", "camera-shake", "css-transition", "math-random", "oklab-gradient"]
  },

  "fonts": {
    "$doc": "렌더는 오프라인. 외부 폰트(CDN) 금지. 레퍼런스가 Poppins 를 쓰면 Pretendard 로 대체. 한 화면의 글자는 세 칸(강조·본문·영문)으로 나눈다: emph = 훅 자막·장면 제목, body = 자막·목록·작은 라벨, latin = 강조 글자 안의 영어·숫자. 정답인 폰트는 없다: 어떤 조합을 쓸지, 칸을 어떻게 섞을지는 취향(type.pair · emph · body · latin). 여기는 쓸 수 있는 목록과, 어기면 정말 깨지는 것만 막는다 (없는 폰트, 칸에 안 맞는 글자). '성격이 반대인 짝' 같은 경험칙은 출발점이라 ⚠️·ℹ️ 까지만. 근거: 세로 쇼츠 2편으로 65쌍 비교 (zexea-education.com/blog/motion-graphics-font-pairing, 시작점 Sequence-st/font-pairing-skill MIT). 어두운 세로 영상만 시험한 값이라 밝은 바탕은 스틸로 본다. size = 글자가 작아 보이는 폰트를 맞추는 배율(@font-face size-adjust): 한글은 글자 폭, 영문은 대문자 높이를 Pretendard 쪽으로. range = 그 글자만 이 폰트로 (Yellowtail 숫자 9 가 낯설어 글자만). local = 저장소에 파일이 없어 사용자가 npm run fonts -- add 로 넣는 폰트.",
    "allowed": ["Pretendard", "SUIT", "Instrument Serif", "Nanum Myeongjo", "Hakgyoansim Allimjang", "IBM Plex Mono", "A2z", "Black Han Sans", "Hahmlet", "Noto Serif KR", "Jua", "Nanum Pen Script", "Asta Sans", "Maru Buri", "Bricolage Grotesque", "Newsreader", "Playfair Display", "Yellowtail", "Archivo Black", "Young Serif", "Caveat", "Abril Fatface", "Cafe24 Ohsquare", "BM Euljiro"],
    "defaultPair": "channel",
    "handMaxChars": 12,
    "library": {
      "pretendard":  {"label": "프리텐다드",       "family": "Pretendard",            "kind": "gothic",  "script": "hangul", "weight": 800, "base": true},
      "suit":        {"label": "SUIT",             "family": "SUIT",                  "kind": "gothic",  "script": "hangul", "weight": 700, "base": true},
      "asta":        {"label": "아스타 산스",      "family": "Asta Sans",             "kind": "gothic",  "script": "hangul", "weight": 700, "faces": [{"file": "fonts/AstaSans-Variable.woff2", "weight": "300 800"}]},
      "maruburi":    {"label": "마루 부리",        "family": "Maru Buri",             "kind": "serif",   "script": "hangul", "weight": 700, "faces": [{"file": "fonts/MaruBuri-Regular.woff2", "weight": "400"}, {"file": "fonts/MaruBuri-Bold.woff2", "weight": "700"}]},
      "allimjang":   {"label": "학교안심 알림장",  "family": "Hakgyoansim Allimjang", "kind": "round",   "script": "hangul", "weight": 400, "base": true},
      "myeongjo":    {"label": "나눔명조",         "family": "Nanum Myeongjo",        "kind": "serif",   "script": "hangul", "weight": 800, "base": true},
