[
 {
  "start": 0.0,
  "end": 1.52,
  "text": "셀카 영상, 하나.",
  "emph": [
   {
    "text": "셀카 영상",
    "tone": "key"
   }
  ],
  "style": "big"
 },
 {
  "start": 1.52,
  "end": 3.02,
  "text": "이걸 클로드한테 넘기면,",
  "emph": [
   {
    "text": "클로드",
    "tone": "key"
   }
  ]
 },
 {
  "start": 3.02,
  "end": 3.98,
  "text": "제가 한 말을,"
 },
 {
  "start": 3.98,
  "end": 5.58,
  "text": "단어 하나하나 읽고요."
 },
 {
  "start": 5.58,
  "end": 6.44,
  "text": "어느 단어에서,"
 },
 {
  "start": 6.44,
  "end": 7.74,
  "text": "무슨 그림을 띄울지,"
 },
 {
  "start": 7.74,
  "end": 8.96,
  "text": "설계도를 씁니다.",
  "emph": [
   {
    "text": "설계도",
    "tone": "key"
   }
  ]
 },
 {
  "start": 8.96,
  "end": 10.4,
  "text": "그러면, 설계도 한 줄이,"
 },
 {
  "start": 10.4,
  "end": 11.6,
  "text": "장면 하나가 돼요.",
  "emph": [
   {
    "text": "장면 하나",
    "tone": "key"
   }
  ]
 },
 {
  "start": 11.6,
  "end": 13.1,
  "text": "오브젝트가 톡 튀어나오고."
 },
 {
  "start": 13.1,
  "end": 13.94,
  "text": "중요한 말엔,"
 },
 {
  "start": 13.94,
  "end": 15.22,
  "text": "형광펜이 그어지고.",
  "emph": [
   {
    "text": "형광펜",
    "tone": "key"
   }
  ]
 },
 {
  "start": 15.22,
  "end": 16.32,
  "text": "화면이 넘어갈 땐,"
 },
 {
  "start": 16.32,
  "end": 17.32,
  "text": "빛이 번지죠."
 },
 {
  "start": 17.32,
  "end": 18.12,
  "text": "편집 프로그램은,",
  "emph": [
   {
    "text": "편집 프로그램",
    "tone": "key"
   }
  ]
 },
 {
  "start": 18.12,
  "end": 19.52,
  "text": "한 번도 안 켰습니다."
 },
 {
  "start": 19.52,
  "end": 20.38,
  "text": "지금 이 화면도,"
 },
 {
  "start": 20.38,
  "end": 21.92,
  "text": "전부 이렇게 만들었고요."
 },
 {
  "start": 21.92,
  "end": 23.02,
  "text": "무료로 풀어둘 테니까.",
  "emph": [
   {
    "text": "무료",
    "tone": "money"
   }
  ]
 },
 {
  "start": 23.02,
  "end": 24.14,
  "text": "아래 repository,"
 },
 {
  "start": 24.14,
  "end": 25.12,
  "text": "git clone 한 줄로",
  "emph": [
   {
    "text": "git clone",
    "tone": "key"
   }
  ]
 },
 {
  "start": 25.12,
  "end": 25.62,
  "text": "받아서,"
 },
 {
  "start": 25.6,
  "end": 26.9,
  "text": "그대로 쓰시면 됩니다.",
  "style": "big"
 }
]